{:name "musty"
 :version "DEVEL"
 :description "An implementation of the Mustache template system"
 :author "Michael Camilleri"
 :license "MIT"
 :url "https://github.com/pyrmont/musty"
 :repo "git+https://github.com/pyrmont/musty"
 :vendored [{:name "medea"
             :url "https://github.com/pyrmont/medea"
             :prefix "deps/medea"
             :paths ["lib/decode.janet"
                     "lib/encode.janet"
                     "init.janet"
                     "LICENSE"]}
            {:name "testament"
             :url "https://github.com/pyrmont/testament"
             :prefix "deps/testament"
             :paths ["lib/testament.janet"
                     "init.janet"
                     "LICENSE"]}]
 :artifacts {:libraries [{:prefix "musty"
                          :paths ["lib"
                                  "init.janet"]}]}}
